<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: lets adb make a reminder fire within minutes. Not in the release build. -->
        <receiver
            android:name=".reminders.DebugRemindReceiver"
            android:exported="true" />

        <!-- Debug builds only: asks the on-device model one real question and logs its raw reply. -->
        <receiver
            android:name=".debug.DebugAskReceiver"
            android:exported="true" />
    </application>
</manifest>
